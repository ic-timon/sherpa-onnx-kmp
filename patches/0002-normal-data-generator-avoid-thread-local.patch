+
 void NormalDataGenerator::Fill(float *data, std::size_t size) const {
   if (seed_ >= 0) {
     // Deterministic mode: use instance-level RNG
@@ -44,14 +49,17 @@ void NormalDataGenerator::Fill(float *data, std::size_t size) const {
