 }

+bool ParseOptions::TrySetOption(const std::string &key,
+                                 const std::string &value,
+                                 std::string *error) {
+  if (error != nullptr) {
+    error->clear();
+  }
+
+  auto fail = [&](const std::string &message) {
+    if (error != nullptr) {
+      *error = message;
+    }
+    return false;
+  };
+
+  if (bool_map_.find(key) != bool_map_.end()) {
+    std::string normalized = value;
+    std::transform(normalized.begin(), normalized.end(), normalized.begin(),
+                   ::tolower);
+    if (normalized == "true" || normalized == "t" || normalized == "1" ||
+        normalized.empty()) {
+      *bool_map_[key] = true;
+      return true;
+    }
+    if (normalized == "false" || normalized == "f" || normalized == "0") {
+      *bool_map_[key] = false;
+      return true;
+    }
+    return fail("Invalid boolean option '" + key + "=" + value + "'");
+  }
+
+  if (int_map_.find(key) != int_map_.end()) {
+    int32_t parsed = 0;
+    if (!ConvertStringToInteger(value, &parsed)) {
+      return fail("Invalid integer option '" + key + "=" + value + "'");
+    }
+    *int_map_[key] = parsed;
+    return true;
+  }
+
+  if (int64_map_.find(key) != int64_map_.end()) {
+    int64_t parsed = 0;
+    if (!ConvertStringToInteger(value, &parsed)) {
+      return fail("Invalid int64 option '" + key + "=" + value + "'");
+    }
+    *int64_map_[key] = parsed;
+    return true;
+  }
+
+  if (uint_map_.find(key) != uint_map_.end()) {
+    uint32_t parsed = 0;
+    if (!ConvertStringToInteger(value, &parsed)) {
+      return fail("Invalid unsigned option '" + key + "=" + value + "'");
+    }
+    *uint_map_[key] = parsed;
+    return true;
+  }
+
+  if (float_map_.find(key) != float_map_.end()) {
+    float parsed = 0;
+    if (!ConvertStringToReal(value, &parsed)) {
+      return fail("Invalid float option '" + key + "=" + value + "'");
+    }
+    *float_map_[key] = parsed;
+    return true;
+  }
+
+  if (double_map_.find(key) != double_map_.end()) {
+    double parsed = 0;
+    if (!ConvertStringToReal(value, &parsed)) {
+      return fail("Invalid double option '" + key + "=" + value + "'");
+    }
+    *double_map_[key] = parsed;
+    return true;
+  }
+
+  if (string_map_.find(key) != string_map_.end()) {
+    *string_map_[key] = value;
+    return true;
+  }
+
+  return fail("Unknown option '" + key + "'");
+}
